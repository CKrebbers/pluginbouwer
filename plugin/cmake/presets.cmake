# presets.cmake — bakt de fabriekspresets uit presets/*.json in het binary (ARCHITECTUUR.md "Presets").
#   pb_presets_tabel(<map met json> <uitvoer .h>)
# Elk bestand is { naam, uitleg, waarden: { <parameternaam>: getal } }; de sleutel is de bestandsnaam zonder .json.
# De uitvoer is een C++-tabel (dub::PRESETS) plus per preset een static_assert: een onbekende parameternaam of een
# waarde buiten het bereik van PARAMS is zo een bouwfout (CMake kent PARAMS niet; de compiler wel).
# Fouten in de JSON zelf (geen object, geen naam, geen getal, dubbele naam) stopt CMake hier al.
function(pb_presets_tabel MAP UIT)
  file(GLOB bestanden CONFIGURE_DEPENDS "${MAP}/*.json")
  list(SORT bestanden)
  if (NOT bestanden)
    message(FATAL_ERROR "presets: geen presets in ${MAP}")
  endif()

  # een JSON-tekst als C++-tekstliteral (UTF-8 blijft UTF-8)
  macro(_pb_literal tekst var)
    string(REPLACE "\\" "\\\\" _t "${tekst}")
    string(REPLACE "\"" "\\\"" _t "${_t}")
    string(REPLACE "\n" "\\n" _t "${_t}")
    set(${var} "\"${_t}\"")
  endmacro()

  set(rijen "")
  set(tabel "")
  set(toetsen "")
  set(namen "")
  set(k 0)
  foreach (f IN LISTS bestanden)
    get_filename_component(sleutel "${f}" NAME_WE)
    if (NOT sleutel MATCHES "^[a-z0-9-]+$")
      message(FATAL_ERROR "presets: ${f}: de bestandsnaam (de load key) mag alleen a-z, 0-9 en - hebben")
    endif()
    file(READ "${f}" json)
    string(JSON naam ERROR_VARIABLE fout GET "${json}" naam)
    if (fout OR naam STREQUAL "")
      message(FATAL_ERROR "presets: ${f}: geen \"naam\" (${fout})")
    endif()
    if (naam IN_LIST namen)
      message(FATAL_ERROR "presets: ${f}: de naam \"${naam}\" staat er al")
    endif()
    list(APPEND namen "${naam}")
    string(JSON uitleg ERROR_VARIABLE fout GET "${json}" uitleg)
    if (fout)
      set(uitleg "")
    endif()
    string(JSON soort ERROR_VARIABLE fout TYPE "${json}" waarden)
    if (fout OR NOT soort STREQUAL "OBJECT")
      message(FATAL_ERROR "presets: ${f}: \"waarden\" is geen object")
    endif()
    string(JSON n LENGTH "${json}" waarden)
    set(waarden "")
    math(EXPR laatste "${n} - 1")
    if (n GREATER 0)
      foreach (j RANGE ${laatste})
        string(JSON pnaam MEMBER "${json}" waarden ${j})
        string(JSON psoort TYPE "${json}" waarden "${pnaam}")
        if (NOT psoort STREQUAL "NUMBER")
          message(FATAL_ERROR "presets: ${f}: \"${pnaam}\" is geen getal")
        endif()
        string(JSON pwaarde GET "${json}" waarden "${pnaam}")
        _pb_literal("${pnaam}" lit)
        string(APPEND waarden "    {${lit}, ${pwaarde}},\n")
      endforeach()
    else()
      set(waarden "    {nullptr, 0},\n")  # leeg: alles op de standaard (een rij van 0 mag in C++ niet)
    endif()
    _pb_literal("${sleutel}" lsleutel)
    _pb_literal("${naam}" lnaam)
    _pb_literal("${uitleg}" luitleg)
    string(APPEND rijen "constexpr PresetWaarde WAARDEN_${k}[] = {\n${waarden}};\n")
    string(APPEND tabel "    {${lsleutel}, ${lnaam}, ${luitleg}, WAARDEN_${k}, ${n},\n"
      "     PB_CLAP_ID \".preset.\" ${lsleutel}, PB_NAAM \": \" ${lnaam}},\n")
    string(APPEND toetsen
      "static_assert(presetGeldig(PRESETS[${k}]), \"presets/${sleutel}.json: onbekende parameternaam of waarde buiten het bereik van PARAMS\");\n")
    math(EXPR k "${k} + 1")
  endforeach()

  set(inhoud "// gegenereerd door plugin/cmake/presets.cmake uit presets/*.json; niet met de hand bewerken\n")
  string(APPEND inhoud "#pragma once\n#include \"presets.h\"\n\nnamespace dub {\nnamespace presets_detail {\n")
  string(APPEND inhoud "${rijen}}  // namespace presets_detail\n\nusing namespace presets_detail;\n")
  string(APPEND inhoud "constexpr int N_PRESETS = ${k};\nconstexpr Preset PRESETS[N_PRESETS] = {\n${tabel}};\n\n")
  string(APPEND inhoud "${toetsen}\n}  // namespace dub\n")
  # alleen schrijven als er iets veranderde (anders bouwt alles bij elke configure opnieuw)
  set(oud "")
  if (EXISTS "${UIT}")
    file(READ "${UIT}" oud)
  endif()
  if (NOT oud STREQUAL inhoud)
    file(WRITE "${UIT}" "${inhoud}")
  endif()
  message(STATUS "presets: ${k} fabriekspresets in ${UIT}")
endfunction()
