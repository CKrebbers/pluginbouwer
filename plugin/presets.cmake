# presets.cmake — bakt de fabriekspresets uit presets/*.json in het binary (ARCHITECTUUR.md "Presets").
#   pb_presets(<map met presets/> <uitvoer .h>)
# Elk bestand is { naam, uitleg, waarden: { <parameternaam>: getal } }; de sleutel is de bestandsnaam zonder .json.
# Wat CMake kan zien (vorm van de JSON, typen, dubbele sleutels of namen) is hier een configure-fout. Of een
# parameternaam bestaat en de waarde binnen het bereik ligt, toetst plugin.cpp met static_assert tegen PARAMS uit
# dsp/ (één bron voor de parameters): ook dat is een bouwfout. De uitvoer is één header met de macro PB_PRESETS.

function(pb_preset_c_tekst uit tekst)  # als C-stringliteral: \ " en regeleinden ontsnapt
  string(REPLACE "\\" "\\\\" tekst "${tekst}")
  string(REPLACE "\"" "\\\"" tekst "${tekst}")
  string(REPLACE "\n" "\\n" tekst "${tekst}")
  string(REPLACE "\r" "\\r" tekst "${tekst}")
  string(REPLACE "\t" "\\t" tekst "${tekst}")
  set(${uit} "\"${tekst}\"" PARENT_SCOPE)
endfunction()

function(pb_presets map uitvoer)
  file(GLOB bestanden CONFIGURE_DEPENDS "${map}/*.json")
  list(SORT bestanden)
  list(LENGTH bestanden aantal)
  if (aantal EQUAL 0)
    message(FATAL_ERROR "presets: geen presets in ${map}")
  endif()

  set(regels "")
  set(maxWaarden 1)
  set(namen "")
  foreach(f IN LISTS bestanden)
    get_filename_component(sleutel "${f}" NAME_WE)
    if (NOT sleutel MATCHES "^[a-z0-9][a-z0-9_-]*$")
      message(FATAL_ERROR "presets: ${f}: de bestandsnaam (de load key) mag alleen a-z, 0-9, - en _ bevatten")
    endif()
    file(READ "${f}" json)

    string(JSON t ERROR_VARIABLE fout TYPE "${json}")
    if (fout OR NOT t STREQUAL "OBJECT")
      message(FATAL_ERROR "presets: ${f}: geen JSON-object (${fout})")
    endif()
    foreach(veld naam uitleg)
      string(JSON t ERROR_VARIABLE fout TYPE "${json}" ${veld})
      if (fout OR NOT t STREQUAL "STRING")
        message(FATAL_ERROR "presets: ${f}: '${veld}' ontbreekt of is geen tekst")
      endif()
    endforeach()
    string(JSON naam GET "${json}" naam)
    string(JSON uitleg GET "${json}" uitleg)
    if (naam STREQUAL "")
      message(FATAL_ERROR "presets: ${f}: 'naam' is leeg")
    endif()
    if (naam IN_LIST namen)
      message(FATAL_ERROR "presets: ${f}: de naam '${naam}' staat al in een ander bestand")
    endif()
    list(APPEND namen "${naam}")
    string(JSON t ERROR_VARIABLE fout TYPE "${json}" waarden)
    if (fout OR NOT t STREQUAL "OBJECT")
      message(FATAL_ERROR "presets: ${f}: 'waarden' ontbreekt of is geen object")
    endif()
    string(JSON n LENGTH "${json}" waarden)
    string(JSON nVelden LENGTH "${json}")
    if (NOT nVelden EQUAL 3)
      message(FATAL_ERROR "presets: ${f}: alleen naam, uitleg en waarden horen erin (${nVelden} velden)")
    endif()

    set(paren "")
    set(gezien "")
    if (n GREATER 0)
      math(EXPR laatste "${n} - 1")
      foreach(k RANGE ${laatste})
        string(JSON pnaam MEMBER "${json}" waarden ${k})
        if (pnaam IN_LIST gezien)
          message(FATAL_ERROR "presets: ${f}: '${pnaam}' staat twee keer in waarden")
        endif()
        list(APPEND gezien "${pnaam}")
        string(JSON t TYPE "${json}" waarden "${pnaam}")
        if (NOT t STREQUAL "NUMBER")
          message(FATAL_ERROR "presets: ${f}: de waarde van '${pnaam}' is geen getal")
        endif()
        string(JSON w GET "${json}" waarden "${pnaam}")
        pb_preset_c_tekst(c "${pnaam}")
        string(APPEND paren "{${c}, ${w}}, ")
      endforeach()
    endif()
    if (n GREATER maxWaarden)
      set(maxWaarden ${n})
    endif()

    pb_preset_c_tekst(cSleutel "${sleutel}")
    pb_preset_c_tekst(cNaam "${naam}")
    pb_preset_c_tekst(cUitleg "${uitleg}")
    string(APPEND regels "  {${cSleutel}, PB_CLAP_ID \".preset.${sleutel}\", PB_NAAM \": \" ${cNaam}, ${cNaam}, ${cUitleg}, ${n}, {${paren}}}, \\\n")
    message(STATUS "preset ${sleutel}: '${naam}', ${n} waarden")
  endforeach()

  set(inhoud "// Gegenereerd door plugin/presets.cmake uit presets/*.json. Niet met de hand veranderen.\n")
  string(APPEND inhoud "// {sleutel (load key), provider-id, providernaam, naam, uitleg, aantal waarden, {{parameternaam, waarde}, ...}}\n")
  string(APPEND inhoud "#pragma once\n#define PB_PRESET_AANTAL ${aantal}\n#define PB_PRESET_MAX_WAARDEN ${maxWaarden}\n")
  string(APPEND inhoud "#define PB_PRESETS \\\n${regels}\n")
  file(WRITE "${uitvoer}.nieuw" "${inhoud}")
  file(COPY_FILE "${uitvoer}.nieuw" "${uitvoer}" ONLY_IF_DIFFERENT)  # anders bouwt alles opnieuw
endfunction()
