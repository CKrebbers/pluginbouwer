# lettertypen.cmake — de lettertypen van design.md (IBM Plex Mono, Silkscreen; beide SIL Open Font License 1.1, vrij
# in te bakken) worden bij het configureren opgehaald uit google/fonts en als byte-array in het binary gebakken: dan
# hoeft er niets naast de plugin te staan en hoeft Clay niets te installeren. Alleen nodig voor het paneel (macOS).
#   pb_lettertypen(<uitvoer.cpp>)  maakt <uitvoer.cpp> met pb_lettertype_plexmono[] en pb_lettertype_silkscreen[]
set(PB_LETTERTYPEN_BRON "https://raw.githubusercontent.com/google/fonts/main/ofl" CACHE STRING "waar de lettertypen vandaan komen")

function(pb_lettertypen uit)
  set(map "${CMAKE_BINARY_DIR}/lettertypen")
  file(MAKE_DIRECTORY "${map}")
  set(inhoud "// gemaakt door plugin/lettertypen.cmake; niet met de hand veranderen\n")
  foreach(paar "plexmono|ibmplexmono/IBMPlexMono-Regular.ttf" "silkscreen|silkscreen/Silkscreen-Regular.ttf")
    string(REPLACE "|" ";" paar "${paar}")
    list(GET paar 0 naam)
    list(GET paar 1 pad)
    get_filename_component(bestand "${pad}" NAME)
    set(doel "${map}/${bestand}")
    if (NOT EXISTS "${doel}")
      file(DOWNLOAD "${PB_LETTERTYPEN_BRON}/${pad}" "${doel}.deel" STATUS st TLS_VERIFY ON)
      list(GET st 0 code)
      if (NOT code EQUAL 0)
        file(REMOVE "${doel}.deel")
        message(FATAL_ERROR "lettertype ${bestand} niet opgehaald (${st}) van ${PB_LETTERTYPEN_BRON}/${pad}")
      endif()
      file(RENAME "${doel}.deel" "${doel}")
    endif()
    file(SIZE "${doel}" grootte)
    file(SHA256 "${doel}" hash)
    file(READ "${doel}" magie LIMIT 4 HEX)
    if (grootte LESS 1000 OR NOT magie STREQUAL "00010000")
      message(FATAL_ERROR "lettertype ${bestand} is geen TrueType (${grootte} bytes, begint met ${magie})")
    endif()
    message(STATUS "lettertype ${bestand}: ${grootte} bytes, sha256 ${hash}")
    file(READ "${doel}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    string(APPEND inhoud "extern \"C\" const unsigned char pb_lettertype_${naam}[] = {${hex}};\n")
    string(APPEND inhoud "extern \"C\" const unsigned long pb_lettertype_${naam}_grootte = ${grootte};\n")
  endforeach()
  file(WRITE "${uit}.nieuw" "${inhoud}")
  file(COPY_FILE "${uit}.nieuw" "${uit}" ONLY_IF_DIFFERENT)
  file(REMOVE "${uit}.nieuw")
endfunction()
