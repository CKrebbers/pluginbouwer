   _sysexBuffers.prepare(16);
+  {
+    ClapWrapper::detail::shared::SpinLockGuard guard(_pendingLock);
+    _pendingParams.clear();
+    _pendingParams.reserve(8192);
+  }
 
   _out_events.ctx = this;
 
@@ -189,6 +194,16 @@ void ProcessAdapter::sortEventIndices()
 
 void ProcessAdapter::process(ProcessData &data)
 {
+  {
+    // take over the parameter events queued by SetParameter (possibly from other threads)
+    ClapWrapper::detail::shared::SpinLockGuard guard(_pendingLock);
+    for (auto &n : _pendingParams)
+    {
+      _eventindices.emplace_back(_events.size());
+      _events.emplace_back(n);
+    }
+    _pendingParams.clear();
+  }
   // CLAP requires event times within [0, frames_count); a host stamping
   // MIDIEventList packets with out-of-range timestamps (e.g. mach host time
   // instead of sample offsets) would otherwise make plugins that index their
@@ -802,7 +817,7 @@ void ProcessAdapter::addParameterEvent(const clap_param_info_t &info, double val
   n.param.channel = -1;
   n.param.note_id = -1;
 
-  this->_eventindices.emplace_back(this->_events.size());
-  this->_events.emplace_back(n);
+  ClapWrapper::detail::shared::SpinLockGuard guard(_pendingLock);
+  this->_pendingParams.emplace_back(n);
 }
 }  // namespace Clap::AUv2
