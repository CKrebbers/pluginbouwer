-static thread_local uint32_t g_audio_thread_override = 0;
+// No thread_local here on Apple/Linux: a thread_local in a dynamically loaded image is allocated (malloc) by the
+// loader the first time each thread touches it. For the host's audio thread that happens inside the realtime
+// render callback (pluginval --rtcheck: "malloc in real-time context" from dyld4::RuntimeState::_instantiateTLVs).
+// pthread TSD with a key created at load time never allocates on get/set for low key numbers.
+#if defined(_WIN32)
+static thread_local uint32_t g_thread_override[2] = {0, 0};
+static uint32_t threadOverrideGet(int which)
+{
+  return g_thread_override[which];
+}
+void threadOverrideAdd(int which, int delta)
+{
+  g_thread_override[which] += delta;
+}
+#else
+static pthread_key_t g_thread_override_key[2];
+static const bool g_thread_override_ok =
+    pthread_key_create(&g_thread_override_key[0], nullptr) == 0 &&
+    pthread_key_create(&g_thread_override_key[1], nullptr) == 0;
+static uint32_t threadOverrideGet(int which)
+{
+  if (!g_thread_override_ok) return 0;
+  return (uint32_t)(uintptr_t)pthread_getspecific(g_thread_override_key[which]);
+}
+void threadOverrideAdd(int which, int delta)
+{
+  if (!g_thread_override_ok) return;
+  pthread_setspecific(g_thread_override_key[which], (void *)(uintptr_t)(threadOverrideGet(which) + delta));
+}
+#endif
 
