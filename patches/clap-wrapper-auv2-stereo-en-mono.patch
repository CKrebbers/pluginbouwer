+bool WrapAsAUV2::selectPortConfig()
+{
+  if (_portConfigCache.empty()) return true;
+  const UInt32 numIn = Inputs().GetNumberOfElements() > 0 ? Input(0).GetStreamFormat().mChannelsPerFrame : 0;
+  const UInt32 numOut = Outputs().GetNumberOfElements() > 0 ? Output(0).GetStreamFormat().mChannelsPerFrame : 0;
+  auto ext = static_cast<const clap_plugin_audio_ports_config_t *>(
+      _plugin->_plugin->get_extension(_plugin->_plugin, CLAP_EXT_AUDIO_PORTS_CONFIG));
+  if (!ext) return false;
+  for (const auto &pc : _portConfigCache)
+  {
+    if (pc.inChannels == numIn && pc.outChannels == numOut)
+    {
+      auto guarantee_mainthread = _plugin->AlwaysMainThread();
+      return ext->select(_plugin->_plugin, pc.id);
+    }
+  }
+  LOGINFO("[clap-wrapper] no audio-ports-config for {} in, {} out", (int)numIn, (int)numOut);
+  return false;
+}
