@@ -585,6 +585,22 @@ OSStatus WrapAsAUV2::SetParameter(AudioUnitParameterID inID, AudioUnitScope inSc
         _processAdapter->addParameterEvent(param, inValue, inBufferOffsetInFrames);
       }
     }
+    else
+    {
+      auto p = _parametertree.find(inID);
+      if (p != _parametertree.end())
+      {
+        const auto id = p->second.get()->info().id;
+        bool found = false;
