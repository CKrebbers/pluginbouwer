@@ -1124,6 +1140,43 @@ void WrapAsAUV2::activateCLAP()
                                      &_parametertree, this, maxSampleFrames, _midi_preferred_dialect,
                                      _midi_supported_dialects, clapAudioInputs, clapAudioOutputs);
 
+    if (!_paramsBeforeInit.empty() && _plugin->_ext._params)
+    {
+      struct PendingEvents
+      {
+        std::vector<clap_event_param_value_t> ev;
+        static uint32_t size(const clap_input_events_t *l)
+        {
+          return (uint32_t) static_cast<PendingEvents *>(l->ctx)->ev.size();
+        }
+        static const clap_event_header_t *get(const clap_input_events_t *l, uint32_t i)
+        {
+          return &static_cast<PendingEvents *>(l->ctx)->ev[i].header;
+        }
+        static bool push(const clap_output_events_t *, const clap_event_header_t *)
+        {
+          return true;
+        }
+      } pending;
+      for (auto &pv : _paramsBeforeInit)
+      {
+        clap_event_param_value_t e{};
+        e.header = {sizeof(e), 0, CLAP_CORE_EVENT_SPACE_ID, CLAP_EVENT_PARAM_VALUE, 0};
+        e.param_id = pv.first;
+        e.cookie = nullptr;
+        e.note_id = -1;
+        e.port_index = -1;
+        e.channel = -1;
+        e.key = -1;
+        e.value = pv.second;
+        pending.ev.push_back(e);
+      }
+      clap_input_events_t in = {&pending, PendingEvents::size, PendingEvents::get};
+      clap_output_events_t out = {&pending, PendingEvents::push};
+      _plugin->_ext._params->flush(_plugin->_plugin, &in, &out);
+      _paramsBeforeInit.clear();
+    }
+
     _plugin->activate();
     _plugin->start_processing();
     _initialized = true;
