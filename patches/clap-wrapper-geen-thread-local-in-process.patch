+// A per-thread counter. On POSIX it lives in a pthread key created at load time: a C++ thread_local in a
+// dynamically loaded plugin is allocated lazily by dyld/glibc on its first use in each thread, and that
+// first use is the audio thread's process call (a real-time violation that pluginval --rtcheck catches).
+class ThreadCounter
+{
+ public:
+  ThreadCounter();
+  uint32_t get() const;
+  void add(int32_t delta);
+
+ private:
+#if !defined(_WIN32)
+  pthread_key_t _key;
+#else
+  uint32_t _slot;
+#endif
+};
+
 class Raise
 {
  public:
-  Raise(uint32_t &counter) : ctx(counter)
+  Raise(ThreadCounter &counter) : ctx(counter)
   {
-    ++ctx;
+    ctx.add(1);
   }
   ~Raise()
   {
-    ctx--;
+    ctx.add(-1);
   }
 
  private:
-  uint32_t &ctx;
+  ThreadCounter &ctx;
 };
 
