+// Pick the CLAP audio-ports-config whose main input/output channel counts match the current AU stream formats and
+// select it (the plugin is deactivated here: Initialize runs before activateCLAP). Without configs: nothing to do.
+bool WrapAsAUV2::selectPortsConfig()
+{
+  if (_portsConfigCache.empty()) return true;
+  auto cfg = static_cast<const clap_plugin_audio_ports_config_t *>(
+      _plugin->_plugin->get_extension(_plugin->_plugin, CLAP_EXT_AUDIO_PORTS_CONFIG));
+  if (!cfg) return true;
+  const uint32_t in = Inputs().GetNumberOfElements() > 0 ? Input(0).GetStreamFormat().mChannelsPerFrame : 0;
+  const uint32_t out = Output(0).GetStreamFormat().mChannelsPerFrame;
+  for (const auto &c : _portsConfigCache)
+  {
+    if (c.inChannels == in && c.outChannels == out)
+    {
+      const bool ok = cfg->select(_plugin->_plugin, c.id);
+      LOGINFO("[clap-wrapper] audio-ports-config {} ({} -> {}) selected: {}", c.id, in, out, ok);
+      return ok;
+    }
+  }
+  LOGINFO("[clap-wrapper] no audio-ports-config for {} -> {} channels", in, out);
+  return false;
+}
